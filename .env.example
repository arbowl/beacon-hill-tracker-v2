# Copy to .env (git-ignored) and fill in. Environment variables override this file.
DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:54329/tracker
SECRET_KEY=replace-with-at-least-32-random-characters
# Local http only; leave unset (true) anywhere served over https.
SECURE_COOKIES=false
# Optional. SMTP_HOST and MAIL_FROM send email; the contact form also needs
# WEBMASTER_EMAIL, and sign-in links also need SITE_URL (e.g. https://beaconhilltracker.org).
# SITE_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# WEBMASTER_EMAIL=
